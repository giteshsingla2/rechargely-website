# Port the site and API listen on
PORT=8090

# Long random string. Required to read or export saved requests:
#   curl -H "Authorization: Bearer $ADMIN_TOKEN" http://localhost:8090/api/recharge-requests
#   curl -H "Authorization: Bearer $ADMIN_TOKEN" http://localhost:8090/api/recharge-requests.csv -o requests.csv
# Leave empty to disable those endpoints.
ADMIN_TOKEN=

# Where requests are stored (one JSON object per line). Defaults to ./data
DATA_DIR=

# Set to 1 only when running behind a proxy/load balancer you control
TRUST_PROXY=
